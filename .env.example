# Copie para .env e preencha. Nunca publique o .env.

# Senha do PostgreSQL
DB_PASSWORD=troque-esta-senha

# Segredo dos tokens de login (pelo menos 32 caracteres aleatórios)
JWT_SECRET=gere-uma-string-longa-e-aleatoria-com-32-ou-mais-caracteres

# Primeira conta de administrador (criada só se o banco estiver vazio)
ADMIN_EMAIL=admin@lure.com.br
ADMIN_PASSWORD=troque-esta-senha-tambem

# Endereço público do site (usado nos links de redefinição de senha)
APP_FRONTEND_URL=http://localhost:8081
WEB_PORT=8081

# E-mail (opcional). Sem isso, o link de "esqueci a senha" aparece só no log do backend.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
