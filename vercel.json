{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://lureedu-api.onrender.com/api/:path*" },
    { "source": "/files/:path*", "destination": "https://lureedu-api.onrender.com/files/:path*" },
    { "source": "/((?!api/|files/).*)", "destination": "/index.html" }
  ]
}
